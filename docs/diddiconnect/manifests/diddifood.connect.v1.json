{
  "$schema": "../diddiconnect.module.v1.schema.json",
  "protocol": "diddiconnect.module.v1",
  "manifest_version": "1.0.0",
  "module": "diddifood",
  "display_name": "DiddiFood",
  "status": "proposed",
  "ownership": {
    "owns": ["orders", "order_state", "order_participants", "order_communication_policy"],
    "does_not_own": ["conversations", "messages", "call_attempts", "support_cases"]
  },
  "identity": {
    "issuer": "diddifree-id",
    "audience": "diddifood",
    "required_service_claims": {"role": "service", "token_type": "service", "status": "active"},
    "required_headers": ["Authorization", "X-Client-ID", "X-Request-ID", "traceparent"]
  },
  "task_contexts": [
    {
      "task_type": "food_order",
      "status": "proposed",
      "method": "GET",
      "path": "/internal/v1/comms/tasks/{task_type}/{task_id}",
      "response_schema": "diddiconnect.task-context.v1",
      "caller": "diddicomms",
      "required_scope": "diddifood:comms-task:read",
      "participant_roles": ["customer", "restaurant", "courier"],
      "phone_numbers": "call_attempt_only",
      "completed_grace_config": null,
      "state_policies": [
        {
          "state": "owner_defined",
          "messaging": "denied",
          "calling": "denied",
          "notes": "Draft placeholder. DiddiFood must replace this with every order state before promotion to implemented."
        }
      ]
    }
  ],
  "support_contexts": [
    {
      "resource_type": "order",
      "status": "proposed",
      "method": "GET",
      "path": "/internal/v1/support/order/{resource_id}/context",
      "response_protocol": "diddi.context.v1",
      "caller": "diddisupport",
      "required_scope": "diddifood:support-context:read",
      "scope_header": "X-Support-Context-Scope",
      "redacted_fields": [
        "participants.phone_e164", "delivery_address.exact_coordinates",
        "restaurant.private_notes", "payment.provider_details"
      ]
    }
  ],
  "connections": [
    {
      "peer_module": "diddicomms",
      "role": "business_context_provider",
      "direction": "inbound",
      "status": "proposed",
      "contract": "docs/integrations/diddifood.md",
      "audience": "diddifood",
      "caller_subject": "service:diddicomms",
      "scopes": ["diddifood:comms-task:read"],
      "blocking_reason": "The order task-context endpoint is not implemented."
    },
    {
      "peer_module": "diddi-support",
      "role": "support_provider",
      "direction": "inbound",
      "status": "proposed",
      "contract": "docs/integrations/diddifood.md",
      "audience": "diddifood",
      "caller_subject": "service:diddisupport",
      "scopes": ["diddifood:support-context:read"],
      "blocking_reason": "No matching Food support-context provider endpoint was found."
    }
  ],
  "events": {
    "transport": "none",
    "delivery": "none",
    "deduplication_key": "none",
    "ordering": "none",
    "published": []
  },
  "reliability": {
    "transactional_outbox": false,
    "inbox_deduplication": false,
    "retry_after_timeout": "read-only resolver calls are safe to retry",
    "websocket_is_source_of_truth": false,
    "readiness_dependencies": ["postgresql"]
  },
  "conformance": {
    "owner_team": "DiddiFood",
    "openapi_path": "docs/api/openapi.json",
    "asyncapi_path": null,
    "contract_test_paths": ["tests/contract/test_diddiconnect_manifest.py"],
    "staging_smoke_test": "required"
  }
}
