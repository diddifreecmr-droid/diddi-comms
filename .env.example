APP_NAME=DiddiComms
ENVIRONMENT=local
API_PREFIX=/comms/v1
DIDDICOMMS_DOCS_PORT=8041
DATABASE_URL=postgresql+asyncpg://diddicomms:diddicomms@localhost:15442/diddicomms_local
ALEMBIC_DATABASE_URL=postgresql+psycopg://diddicomms:diddicomms@localhost:15442/diddicomms_local
REDIS_URL=redis://localhost:16442/0
REDIS_KEY_PREFIX=diddicomms
SUPPORT_EVENTS_REDIS_URL=redis://localhost:16382/0
DIDDISUPPORT_REDIS_HOST_PORT=16382
IDENTITY_ISSUER=diddifree-id
IDENTITY_AUDIENCE=diddicomms
IDENTITY_JWKS_URL=http://localhost:8000/.well-known/jwks.json
IDENTITY_SERVICE_TOKEN_URL=http://localhost:8000/identity/v1/auth/service/token
DIDDISUPPORT_BASE_URL=http://localhost:8040
DIDDISUPPORT_CLIENT_ID=diddicomms-local-diddicomms
DIDDISUPPORT_CLIENT_SECRET=
DIDDISUPPORT_AUDIENCE=diddi-support
DIDDISUPPORT_SCOPE=diddi-support:cases:read
DIDDISUPPORT_CREATE_SCOPE=diddi-support:cases:create
DIDDISUPPORT_MESSAGES_SCOPE=diddi-support:messages:write
METRICS_BEARER_TOKEN=local-dev-metrics-token
OWNER_SERVICE_RESOLVERS_JSON={"diddigo":{"base_url":"http://localhost:8010","client_id":"diddicomms-local-diddigo","client_secret":"","audience":"diddigo","scope":"diddigo:comms-task:read"},"diddisend":{"base_url":"http://localhost:8020","client_id":"diddicomms-local-diddisend","client_secret":"","audience":"diddisend","scope":"diddisend:comms-task:read"},"diddifood":{"base_url":"http://localhost:8030","client_id":"diddicomms-local-diddifood","client_secret":"","audience":"diddifood","scope":"diddifood:comms-task:read"}}
OTEL_EXPORTER_OTLP_ENDPOINT=
TASK_CONVERSATION_GRACE_MINUTES=60
MESSAGE_RETENTION_DAYS=180
OUTBOX_MAX_ATTEMPTS=5
WORKER_RETRY_MAX_SECONDS=30
WORKER_METRICS_REFRESH_SECONDS=10
WEBSOCKET_HEARTBEAT_SECONDS=15
WEBSOCKET_IDLE_TIMEOUT_SECONDS=90
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_MAX_CONNECTIONS_PER_CONVERSATION=200
SUPPORT_EVENTS_STREAM=diddisupport.events
SUPPORT_EVENTS_CONSUMER_GROUP=diddicomms
SUPPORT_EVENTS_CONSUMER_NAME=diddicomms-worker-local
INBOUND_EVENTS_DLQ_STREAM=diddicomms.inbound.dlq
EVENT_CONSUMER_MAX_ATTEMPTS=5
EVENT_CONSUMER_RECLAIM_IDLE_MS=60000
MESSAGE_RATE_LIMIT_PER_MINUTE=30
CALL_RATE_LIMIT_PER_FIVE_MINUTES=5
SUPPORT_CASE_RATE_LIMIT_PER_HOUR=10
EVENTS_STREAM_MAXLEN=100000
EVENTS_DLQ_STREAM_MAXLEN=10000

# Tests staging manuels (ne sont pas utilises par le runtime de l'application)
RUN_STAGING_SMOKE_TESTS=0
RUN_STAGING_WRITE_TESTS=0
DIDDICOMMS_STAGING_BASE_URL=https://diddi-comm-staging.diddifree.com
DIDDISUPPORT_STAGING_BASE_URL=http://support-backend-staging.diddifree.com
STAGING_HTTP_TIMEOUT_SECONDS=15
DIDDICOMMS_STAGING_USER_TOKEN=
